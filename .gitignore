# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments (make setup recreates them)
.venv
.venv-seg

# Local Claude Code settings
.claude/settings.local.json

# Datasets: re-downloadable, and Replica's terms do not allow redistributing them
/room-data/
/rgbd_dataset_freiburg3_long_office_household/
*.tgz
*:Zone.Identifier

# COLMAP binaries (depth/normal maps, sparse models, vocabulary trees): large and regenerable
*.bin

# Run outputs (results/ from rr-benchmark, out/ from make run): only pictures/ and mesh/ are
# tracked. Everything else stays on disk but out of git, so a tracked run can be re-run, not resumed.
/results/**
/out/**
!/results/**/
!/out/**/
!/results/**/pictures/**
!/out/**/pictures/**
!/results/**/mesh/**
!/out/**/mesh/**
